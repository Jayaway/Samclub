# Alipay Configuration
# Apply at: https://open.alipay.com/ (需要已签约"手机网站支付"或"电脑网站支付"产品)

ALIPAY_APP_ID=2021xxxxxx
ALIPAY_PRIVATE_KEY=your_rsa2_private_key_here
ALIPAY_PUBLIC_KEY=alipay_rsa2_public_key_here
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_RETURN_URL=http://localhost:5175/payment-callback
ALIPAY_NOTIFY_URL=http://localhost:3000/api/alipay/notify
